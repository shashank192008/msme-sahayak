# ============================================================================
# MSME SAHAYAK - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and configure your local MySQL credentials
# ============================================================================

# Application Port
PORT=3000

# Local MySQL Server Credentials
# These connect directly to your local MySQL Server / MySQL Workbench instance
MYSQL_HOST="localhost"
MYSQL_PORT="3306"
MYSQL_USER="root"
MYSQL_PASSWORD="your_mysql_password"
MYSQL_DATABASE="msme_sahayak"

# AI Studio injected variables (Optional)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="http://localhost:3000"
